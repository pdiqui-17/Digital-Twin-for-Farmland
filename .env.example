# ============================================================================
# Cấu hình môi trường mẫu cho phát triển local (Copy file này thành .env)
# LƯU Ý: KHÔNG commit file .env thật lên Git!
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL / TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_twin_farm
POSTGRES_USER=twin_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# --- MQTT Broker (Mosquitto) ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Apache Kafka (KRaft) ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=digital-twin-local

# --- MinIO (S3-compatible Object Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_USE_SSL=false
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_MINIO_PASSWORD
MINIO_RAW_BUCKET=telemetry-raw

# --- Simulator Service ---
SIMULATOR_PORT=3001
SIMULATOR_FARM_ID=farm-01
SIMULATOR_ZONE_COUNT=4
SIMULATOR_VIRTUAL_SENSORS_PER_ZONE=0
SIMULATOR_TICK_INTERVAL_MS=5000
# Số phút vật lý mỗi tick (mặc định 5 -> nhanh 60 lần). Role B suy tỉ lệ thời gian từ 2 biến này
SIMULATOR_PHYSICS_MINUTES_PER_TICK=5
SIMULATOR_DROUGHT_MODE=false
SIMULATOR_WEATHER_ENABLED=true

# --- Processor Service ---
PROCESSOR_PORT=3002
PROCESSOR_CONSUMER_GROUP=processor-telemetry-group
PROCESSOR_BATCH_SIZE=50
PROCESSOR_MINIO_ENABLED=true

# --- Role B: Twin Service (3010), Controller (3011), Analytics (3012) ---
# Danh sách đầy đủ biến và mặc định: docs/api.md
TWIN_STORE=pg
TWIN_INGEST=kafka
CONTROLLER_STORE=pg

# Số giây ruộng trong 1 giây thật. Để trống = tự suy từ SIMULATOR_TICK_INTERVAL_MS và
# SIMULATOR_PHYSICS_MINUTES_PER_TICK (mặc định nhanh 60 lần). Nông trại thật: 1
SIM_TIME_SCALE=

# Controller. Các giá trị dưới đây là mặc định; xóa dòng thì code dùng đúng giá trị này.
# Giây RUỘNG (tự chia theo tốc độ mô phỏng, không cần sửa khi đổi tốc độ simulator):
CTRL_MAX_RUN_SEC=1800
CTRL_MIN_REST_SEC=3600
CTRL_ALERT_COOLDOWN_SEC=600
# Giây THẬT (độ trễ thiết bị/mạng, không chia):
CTRL_ACK_TIMEOUT_SEC=30
CTRL_FAULT_CONFIRM_SEC=15
CTRL_UNKNOWN_CONFIRM_SEC=60
# Chu kỳ tick (giây thật). Để trống = tự chọn khoảng 10 phút ruộng, trong 1-10 s
CTRL_TICK_SEC=
# Đóng van khi độ ẩm đạt vị trí này trong khoảng tối ưu (0 = cận dưới, 1 = cận trên)
CTRL_STOP_FRACTION=0.5
# 0 = chỉ cảnh báo, không tự tưới
AUTO_IRRIGATION=1
# Tưới sớm khi analytics dự đoán độ ẩm sẽ xuống dưới ngưỡng khô (0 = tắt). Analytics tắt, lỗi hoặc
# chưa calibrate zone đó thì controller tự quay về luật theo ngưỡng.
CTRL_PREDICT=1
# Tầm dự đoán, giờ ruộng (mô hình đáng tin ở 1-3 giờ)
CTRL_PREDICT_HOURS=1
ANALYTICS_URL=http://localhost:3012
# Nơi analytics lưu hệ số đã calibrate theo zone. Không đặt biến này (để nguyên comment) thì dùng mặc định:
#   - chạy bằng npm: <repo>/.data/analytics-model.json
#   - chạy bằng image dtf-analytics: /data/analytics-model.json (đặt sẵn trong image, gắn volume vào /data)
# Đừng đặt rỗng: biến rỗng ghi đè giá trị của image và analytics không ghi được file (calibrate trả 500).
# ANALYTICS_MODEL_FILE=/data/analytics-model.json

# Thông báo Telegram (để trống thì chỉ ghi log)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

