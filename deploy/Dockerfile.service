# Dùng chung cho 3 service của Role B (twin-service, controller, analytics). Build từ thư mục gốc repo:
#   docker build -f deploy/Dockerfile.service --build-arg SERVICE=twin-service -t digital-twin/twin-service .
# Service của B chạy TypeScript trực tiếp bằng tsx; @digital-twin/shared được build sang dist.
# C kiểm tra và tối ưu thêm (multi-stage giống services/processor/Dockerfile, image nhỏ hơn).
FROM node:22-alpine
WORKDIR /app
ARG SERVICE
ENV SERVICE=${SERVICE} NODE_ENV=production
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
# tsx/typescript là devDependency của root.
RUN npm ci --include=dev && npm run build:shared
USER node
CMD ["sh", "-c", "cd services/${SERVICE} && exec npx tsx src/index.ts"]
