{
  "title": "Farm Digital Twin",
  "uid": "farm-twin",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "type": "datasource",
      "pluginId": "postgres"
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Trạng thái zone (twin_state)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT zone_id AS zone, state->>'status' AS status, (state->'metrics'->>'soilMoisture')::float AS \"độ ẩm đất %\", (state->'derived'->>'waterStress')::float AS \"stress nước\", (state->'derived'->>'fungalRisk')::float AS \"nguy cơ nấm\", state->'valve'->>'state' AS van, updated_at FROM twin_state ORDER BY zone_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "text": "ok"
                      },
                      "dry": {
                        "color": "orange",
                        "text": "dry"
                      },
                      "critical": {
                        "color": "red",
                        "text": "critical"
                      },
                      "unknown": {
                        "color": "gray",
                        "text": "unknown"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Độ ẩm đất theo zone",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,'1m'), zone_id AS metric, avg(value) AS value FROM sensor_readings WHERE $__timeFilter(ts) AND type='soil_moisture' AND quality <> 'bad' GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Nhiệt độ và độ ẩm không khí",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts,'1m'), zone_id || ' ' || type AS metric, avg(value) AS value FROM sensor_readings WHERE $__timeFilter(ts) AND type IN ('air_temp','air_humidity') GROUP BY 1,2 ORDER BY 1"
        }
      ]
    },
    {
      "type": "table",
      "title": "Lệnh van gần đây",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts, zone_id, action, reason FROM commands WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ]
    },
    {
      "type": "table",
      "title": "Cảnh báo (đang mở ở trên)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT opened_at, closed_at, zone_id, rule, severity, message FROM alerts WHERE opened_at >= $__timeFrom() ORDER BY (closed_at IS NULL) DESC, opened_at DESC LIMIT 100"
        }
      ]
    }
  ]
}